      "position": [460, 300],
      "credentials": {
        "oAuth2Api": {
          "id": "salesforce-agent-oauth2",
          "name": "Salesforce Agent API (Client Credentials)"
        }
      }
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
      "main": [[{ "node": "Call Salesforce", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
