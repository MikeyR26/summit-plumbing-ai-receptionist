{
  "name": "SF - Book Appointment",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            { "name": "serviceAppointmentId" },
            { "name": "slotStartIso" },
            { "name": "slotEndIso" }
          ]
        }
      },
      "id": "a1b2c304-0001-4000-8000-000000000001",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
