        "method": "POST",
        "url": "={{ $env.SF_INSTANCE_URL }}/services/apexrest/agent/v1/bookAppointment",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ serviceAppointmentId: $json.serviceAppointmentId, slotStartIso: $json.slotStartIso, slotEndIso: $json.slotEndIso }) }}",
        "options": {}
      },
      "id": "a1b2c304-0001-4000-8000-000000000002",
      "name": "Call Salesforce",
      "type": "n8n-nodes-base.httpRequest",
